# scripts/deploy.sh generates .env.server with a random password (mode 0600).
# Do not commit that generated file or share its contents.
SONGCUT_SERVER_USERNAME=admin
# Required when configuring manually; use a new random password of at least 16 characters.
SONGCUT_SERVER_PASSWORD=
SONGCUT_PUBLIC_ORIGIN=http://localhost:8765
SONGCUT_BIND=127.0.0.1
SONGCUT_HTTP_PORT=8765
SONGCUT_DOMAIN=
