{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VTuber SongCut",
  "version": "0.1.0",
  "identifier": "io.songcut.studio",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8765; media-src 'self' http://127.0.0.1:8765 blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local VTuber song detection and clip studio",
    "category": "Video",
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
