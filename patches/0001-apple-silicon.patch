+"""An embedding app may provide FFmpeg without changing the user's PATH."""
+import os
+from pathlib import Path
+import struct
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'src'))
+import bilibili
+from features import load_audio
+from infer import cut_video
+
+
+class FFmpegOverrideTests(unittest.TestCase):
+    def test_audio_fallback_uses_override_or_default_executable(self):
+        for override in [None, '', '/provided tools/ffmpeg']:
+            env = dict(os.environ)
+            env.pop('AUTOSLICER_FFMPEG', None)
+            if override is not None:
+                env['AUTOSLICER_FFMPEG'] = override
+            with self.subTest(override=override), patch.dict(os.environ, env, clear=True), \
+                    patch('features.torchaudio.load', side_effect=RuntimeError('no decoder')), \
+                    patch('subprocess.run', return_value=SimpleNamespace(stdout=struct.pack('<2f', .25, -.5))) as run:
+                wav = load_audio('file with spaces.mp4')
+                np.testing.assert_array_equal(wav.numpy(), [.25, -.5])
+                self.assertEqual(run.call_args.args[0][0], override or 'ffmpeg')
+                self.assertIn('file with spaces.mp4', run.call_args.args[0])
+                self.assertTrue(run.call_args.kwargs['check'])
+
+    def test_both_clip_copy_and_reencode_use_override(self):
+        with patch.dict(os.environ, {'AUTOSLICER_FFMPEG': '/provided tools/ffmpeg'}), \
+                patch('infer.subprocess.run', side_effect=[SimpleNamespace(returncode=1),
+                                                          SimpleNamespace(returncode=0)]) as run:
+            cut_video(Path('source.mp4'), [{'cut_start': 1, 'cut_end': 2}], Path('out'), 'test')
+        self.assertEqual(run.call_count, 2)
+        for call in run.call_args_list:
+            self.assertEqual(call.args[0][0], '/provided tools/ffmpeg')
+        self.assertTrue(run.call_args.kwargs['check'])
+
+    def test_downloader_audio_remux_and_video_mux_use_override(self):
+        (ROOT / 'runs').mkdir(exist_ok=True)
+        stream = {'bandwidth': 1000, 'baseUrl': 'https://unused.invalid/stream',
+                  'id': 1, 'codecs': 'test'}
+        view = {'pages': [{'cid': 1, 'duration': 1}], 'title': 'test'}
+        def fake_download(urls, target, cookie):
+            target.touch()
+        with tempfile.TemporaryDirectory(prefix='ffmpeg-', dir=ROOT / 'runs') as temp:
+            for video in [False, True]:
+                with self.subTest(video=video), \
+                        patch.dict(os.environ, {'AUTOSLICER_FFMPEG': '/provided tools/ffmpeg'}), \
+                        patch('bilibili.resolve_input', return_value=('BVtest', 1)), \
+                        patch('bilibili.get_view', return_value=view), \
+                        patch('bilibili.get_dash', return_value={'audio': [stream], 'video': [stream]}), \
+                        patch('bilibili._download', side_effect=fake_download), \
+                        patch('bilibili.subprocess.run') as run:
+                    result = bilibili.download('unused', Path(temp), want_video=video)
+                    self.assertEqual(result.suffix, '.mp4' if video else '.m4a')
+                    self.assertEqual(run.call_args.args[0][0], '/provided tools/ffmpeg')
+                    self.assertTrue(run.call_args.kwargs['check'])
+
+    @unittest.skipUnless(os.environ.get('AUTOSLICER_FFMPEG'), 'set AUTOSLICER_FFMPEG for real decode test')
+    def test_actual_ffmpeg_decode_with_empty_path(self):
+        """Prove a bundled absolute executable works when FFmpeg is absent from PATH."""
+        import wave
+        (ROOT / 'runs').mkdir(exist_ok=True)
+        with tempfile.TemporaryDirectory(prefix='ffmpeg-', dir=ROOT / 'runs') as temp:
+            source = Path(temp) / 'synthetic.wav'
+            samples = np.tile(np.array([0, 8192, -8192, 0], dtype='<i2'), 400)
+            with wave.open(str(source), 'wb') as audio:
+                audio.setnchannels(1)
+                audio.setsampwidth(2)
+                audio.setframerate(16000)
+                audio.writeframes(samples.tobytes())
+            with patch.dict(os.environ, {'PATH': ''}), \
+                    patch('features.torchaudio.load', side_effect=RuntimeError('no decoder')):
+                wav = load_audio(source)
+            np.testing.assert_allclose(wav.numpy(), samples.astype(np.float32) / 32768, atol=1e-7)
+
+
+if __name__ == '__main__':
+    unittest.main()
