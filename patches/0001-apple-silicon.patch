diff --git a/src/devices.py b/src/devices.py
new file mode 100644
index 0000000..8c7bd5c
--- /dev/null
+++ b/src/devices.py
@@ -0,0 +1,40 @@
+"""Shared compute policy. MPS uses FP32 and a CPU spectral frontend."""
+from contextlib import nullcontext
+
+import torch
+
+
+def resolve_device(requested: str | torch.device | None = None, gpu: int = 0) -> torch.device:
+    """Prefer CUDA, then Apple MPS, then CPU; explicit requests never fall back."""
+    if requested in (None, "auto"):
+        requested = (f"cuda:{gpu}" if torch.cuda.is_available() else
+                     "mps" if torch.backends.mps.is_available() else "cpu")
+    device = torch.device(requested)
+    if device.type == "cuda":
+        if not torch.cuda.is_available():
+            raise ValueError("CUDA is unavailable; use --device cpu or --device mps")
+        index = device.index if device.index is not None else gpu
+        if index < 0 or index >= torch.cuda.device_count():
+            raise ValueError(f"CUDA device index {index} is unavailable")
+        device = torch.device(f"cuda:{index}")
+    elif device.type == "mps":
+        if not torch.backends.mps.is_available():
+            raise ValueError("MPS is unavailable; use --device cpu")
+    elif device.type != "cpu":
+        raise ValueError(f"Unsupported device: {device}")
+    return device
+
+
+def autocast_context(device: torch.device):
+    # BF16 is not supported on every CUDA GPU. Keep those devices in FP32 too.
+    if device.type == "cuda":
+        with torch.cuda.device(device):
+            if torch.cuda.is_bf16_supported():
+                return torch.autocast("cuda", dtype=torch.bfloat16)
+    return nullcontext()
+
+
+def feature_device(device: torch.device) -> torch.device:
+    # STFT creates complex tensors, which are not universally supported by MPS.
+    # Only feature extraction stays on CPU; model forward/backward stays on MPS.
+    return torch.device("cpu") if device.type == "mps" else device
