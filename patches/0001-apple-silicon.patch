diff --git a/tests/test_apple_silicon.py b/tests/test_apple_silicon.py
new file mode 100644
index 0000000..6861496
--- /dev/null
+++ b/tests/test_apple_silicon.py
@@ -0,0 +1,126 @@
+"""Synthetic compatibility checks, not singing-detection accuracy benchmarks.
+
+AUTOSLICER_CHECKPOINT=/path/to/best.pt enables released-weight parity checks.
+All accelerator tests skip on hosts without MPS. No fallback environment flag is set.
+"""
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import numpy as np
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'src'))
+from devices import autocast_context
+from features import extract_logmel_file
+from infer import predict_probs
+from models import build_model
+
+MPS = torch.backends.mps.is_available()
+CHECKPOINT = os.environ.get('AUTOSLICER_CHECKPOINT')
+
+
+def devices():
+    return ['cpu', 'mps'] if MPS else ['cpu']
+
+
+class CompatibilityTests(unittest.TestCase):
+    def test_crnn_multiclass_forward_backward_and_optimizer(self):
+        """Exercise all default CNN/GRU layers and the four-class release head."""
+        for requested in devices():
+            with self.subTest(device=requested):
+                torch.manual_seed(42)
+                device = torch.device(requested)
+                model = build_model('crnn', n_out=4).to(device).train()
+                optimizer = torch.optim.AdamW(model.parameters(), lr=1e-3)
+                before = model.head[-1].weight.detach().clone()
+                x = torch.randn(2, 80, 128).to(device)
+                y = torch.arange(16).reshape(2, 8).remainder(4).to(device)
+                with autocast_context(device):
+                    logits = model(x)
+                    loss = torch.nn.functional.cross_entropy(logits.flatten(0, 1), y.flatten())
+                self.assertEqual(tuple(logits.shape), (2, 8, 4))
+                self.assertTrue(torch.isfinite(loss).item())
+                loss.backward()
