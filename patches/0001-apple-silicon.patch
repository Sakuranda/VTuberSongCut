+"""Device policy regressions; CUDA cases are mocked so these run on any host."""
+import sys
+import unittest
+from contextlib import nullcontext
+from pathlib import Path
+from unittest.mock import patch
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
+from devices import autocast_context, feature_device, resolve_device
+
+
+class DevicePolicyTests(unittest.TestCase):
+    def test_auto_priority_and_gpu_index(self):
+        for cuda, mps, expected in [(True, True, 'cuda:1'),
+                                    (False, True, 'mps'),
+                                    (False, False, 'cpu')]:
+            with self.subTest(expected=expected), \
+                    patch('torch.cuda.is_available', return_value=cuda), \
+                    patch('torch.cuda.device_count', return_value=2), \
+                    patch('torch.backends.mps.is_available', return_value=mps):
+                self.assertEqual(str(resolve_device('auto', gpu=1)), expected)
+                self.assertEqual(str(resolve_device(None, gpu=1)), expected)
+
+    def test_explicit_cpu_works_without_accelerators(self):
+        with patch('torch.cuda.is_available', return_value=False), \
+                patch('torch.backends.mps.is_available', return_value=False):
+            self.assertEqual(resolve_device('cpu'), torch.device('cpu'))
+            self.assertEqual(resolve_device(torch.device('cpu')), torch.device('cpu'))
+            for requested in ['mps', 'cuda']:
+                with self.subTest(requested=requested), self.assertRaises(ValueError):
+                    resolve_device(requested)
+
+    def test_explicit_cuda_index_overrides_gpu_flag(self):
+        with patch('torch.cuda.is_available', return_value=True), \
+                patch('torch.cuda.device_count', return_value=2):
+            self.assertEqual(str(resolve_device('cuda', gpu=1)), 'cuda:1')
+            self.assertEqual(str(resolve_device('cuda:0', gpu=1)), 'cuda:0')
+            with self.assertRaises(ValueError):
+                resolve_device('cuda:2')
+        with self.assertRaises(ValueError):
+            resolve_device('meta')
+
+    def test_mps_frontend_uses_cpu_but_cuda_frontend_stays_on_cuda(self):
+        for requested, expected in [('cpu', 'cpu'), ('mps', 'cpu'), ('cuda:1', 'cuda:1')]:
+            self.assertEqual(str(feature_device(torch.device(requested))), expected)
+
+    def test_cpu_and_mps_do_not_enable_cuda_autocast(self):
+        with patch('torch.autocast') as autocast:
+            for device in ['cpu', 'mps']:
+                with autocast_context(torch.device(device)):
+                    pass
+            autocast.assert_not_called()
+
+    def test_cuda_bf16_requires_hardware_support(self):
+        for supported in [False, True]:
+            with self.subTest(bf16=supported), \
+                    patch('torch.cuda.device', return_value=nullcontext()), \
+                    patch('torch.cuda.is_bf16_supported', return_value=supported), \
+                    patch('torch.autocast', return_value=nullcontext()) as autocast:
+                with autocast_context(torch.device('cuda:0')):
+                    pass
+                if supported:
+                    autocast.assert_called_once_with('cuda', dtype=torch.bfloat16)
+                else:
+                    autocast.assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main()
