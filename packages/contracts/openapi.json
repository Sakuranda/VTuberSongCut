  "components": {
    "schemas": {
      "Body_upload_api_projects_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_projects_upload_post"
      },
      "Clip": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Ms"
          },
          "end_ms": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "End Ms"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": "未命名歌曲"
          },
          "original_artist": {
            "type": "string",
            "title": "Original Artist",
            "default": ""
          },
          "performer": {
            "type": "string",
            "title": "Performer",
            "default": ""
          },
          "detection": {
            "type": "string",
            "enum": [
              "manual",
              "autoslicer"
            ],
            "title": "Detection",
            "default": "manual"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/SongCandidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "lyrics": {
            "items": {
              "$ref": "#/components/schemas/LyricCue"
            },
            "type": "array",
            "title": "Lyrics"
          },
          "subtitle": {
            "$ref": "#/components/schemas/SubtitleStyle"
          },
          "export_settings": {
            "$ref": "#/components/schemas/ExportSettings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start_ms",
          "end_ms"
        ],
        "title": "Clip"
      },
      "ExportSettings": {
        "properties": {
          "video": {
            "type": "boolean",
            "title": "Video",
            "default": true
          },
          "audio": {
            "type": "boolean",
            "title": "Audio",
            "default": true
          },
          "video_codec": {
            "type": "string",
            "enum": [
              "h264",
              "hevc"
            ],
            "title": "Video Codec",
            "default": "h264"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "source",
              "720p",
              "1080p",
              "2160p"
            ],
            "title": "Resolution",
            "default": "source"
          },
          "fps": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  24,
                  25,
                  30,
                  50,
                  60
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Fps"
          },
          "rate_control": {
            "type": "string",
            "enum": [
              "quality",
              "bitrate"
            ],
            "title": "Rate Control",
            "default": "quality"
          },
          "crf": {
            "type": "integer",
            "maximum": 40.0,
            "minimum": 0.0,
            "title": "Crf",
            "default": 20
          },
          "video_bitrate_kbps": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 250.0,
            "title": "Video Bitrate Kbps",
            "default": 8000
          },
          "audio_bitrate_kbps": {
            "type": "integer",
            "enum": [
              64,
              96,
              128,
              160,
              192,
              256,
              320
            ],
            "title": "Audio Bitrate Kbps",
            "default": 192
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ExportSettings"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportLyrics": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "offset_ms": {
            "type": "integer",
            "title": "Offset Ms",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ImportLyrics"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "input_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Revision"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "interrupted"
            ],
            "title": "Status",
            "default": "queued"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "等待处理"
          },
          "artifacts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Artifacts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project_id",
          "kind"
        ],
        "title": "Job"
      },
      "LyricCue": {
        "properties": {
          "start_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Ms"
          },
          "end_ms": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "End Ms"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "words": {
            "items": {
              "$ref": "#/components/schemas/LyricWord"
            },
            "type": "array",
            "title": "Words"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start_ms",
          "end_ms",
          "text"
        ],
        "title": "LyricCue"
      },
      "LyricWord": {
        "properties": {
          "start_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Ms"
          },
          "end_ms": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "End Ms"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start_ms",
          "end_ms",
          "text"
        ],
        "title": "LyricWord"
      },
      "Project": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "title": "Schema Version",
            "default": 1
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision",
            "default": 0
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          },
          "source_file": {
            "type": "string",
            "title": "Source File"
          },
          "duration_ms": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Duration Ms"
          },
          "has_video": {
            "type": "boolean",
            "title": "Has Video",
            "default": true
          },
          "source_fps": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Fps"
          },
          "preview_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preview File"
          },
          "clips": {
            "items": {
              "$ref": "#/components/schemas/Clip"
            },
            "type": "array",
            "title": "Clips"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "source_name",
          "source_file",
          "duration_ms"
        ],
        "title": "Project"
      },
      "SaveProject": {
        "properties": {
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "clips": {
            "items": {
              "$ref": "#/components/schemas/Clip"
            },
            "type": "array",
            "title": "Clips"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "clips"
        ],
        "title": "SaveProject"
      },
      "SongCandidate": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "artist": {
            "type": "string",
            "title": "Artist",
            "default": ""
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "evidence": {
            "type": "string",
            "title": "Evidence",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "provider"
        ],
        "title": "SongCandidate"
      },
      "SubtitleStyle": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "layout": {
            "type": "string",
            "enum": [
              "single",
              "double",
              "ktv"
            ],
            "title": "Layout",
            "default": "single"
          },
          "font_size": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 16.0,
            "title": "Font Size",
            "default": 42
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "title": "Color",
            "default": "#FFFFFF"
          },
          "highlight": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "title": "Highlight",
            "default": "#FFCF70"
          },
          "margin_bottom": {
            "type": "integer",
            "maximum": 400.0,
            "minimum": 0.0,
            "title": "Margin Bottom",
            "default": 48
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SubtitleStyle"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
